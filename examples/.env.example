# Copy to .env and adjust. Every MLW_* variable is documented in docs/ENVIRONMENT.md.
MLW_TAG=latest
CONFIG_DIR=./config
CACHE_DIR=./cache
MEDIA_DIR=/srv/media

# Server user (owner of ./config and ./cache) - "id -u" / "id -g" of the account that owns your files
PUID=1000
PGID=1000
TZ=Europe/Bucharest

# first-run (default): written when the server is new and whenever you change a value here
# enforce: written at every start (changes made in the dashboard are reverted)
MLW_CONFIG_MODE=first-run

MLW_SERVER_NAME=Home media
MLW_UI_CULTURE=en-US
MLW_METADATA_LANGUAGE=en
MLW_METADATA_COUNTRY=US

# Behind a reverse proxy:
MLW_PUBLISHED_URL=
MLW_BASE_URL=
MLW_KNOWN_PROXIES=

MLW_ADMIN_USER=admin

# Plugins from the medialab.works catalog, e.g. jf-rosub,jf-registration@1.0.2
MLW_PLUGINS=
MLW_PLUGINS_UPDATE=false

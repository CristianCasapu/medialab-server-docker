# medialab Server container: the in-app updater (root systemd service) cannot run in a container.
# Without these files the "Self-Update by MediaLab" plugin reports "no updater" and only lists versions.
path-exclude=/usr/lib/medialab-server/update.sh
path-exclude=/lib/systemd/system/medialab-update.*
path-exclude=/usr/lib/systemd/system/medialab-update.*
# Documentation and translations we do not need in the image (the server ships its own).
path-exclude=/usr/share/man/*
path-exclude=/usr/share/info/*
path-exclude=/usr/share/locale/*
path-include=/usr/share/locale/locale.alias
path-exclude=/usr/share/doc/*
path-include=/usr/share/doc/*/copyright
path-include=/usr/share/doc/medialab-server/*
